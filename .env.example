# =============================================================================
# .env.example — plantilla de variables de entorno (SÍ se versiona en Git)
# =============================================================================
# ¿Qué es?
#   Modelo de las variables que el proyecto necesita para arrancar.
#   No contiene secretos reales: es la “guía” para crear tu propio `.env`.
#
# ¿Por qué existe?
#   HU-001 (RN-002): toda configuración sensible/variable debe venir del entorno.
#   Cada desarrollador copia este archivo a `.env` y pone SUS valores.
#
# Flujo típico:
#   cp .env.example .env
#   # editas .env con contraseñas reales (ese archivo NO se sube a Git)
#
# Guía detallada: docs/config/env.example.md
# =============================================================================

# Ambiente de ejecución: development | qa | production | test
NODE_ENV=development

# Puerto HTTP donde NestJS escucha (dentro y fuera de Docker suele ser 3000)
PORT=3000

# --- Credenciales iniciales de PostgreSQL (servicio `db` en Compose) ---------
# Docker usa estas vars al crear la base la primera vez.
POSTGRES_USER=multicine
POSTGRES_PASSWORD=change_me
POSTGRES_DB=multicine_db

# --- Conexión que usa la API Nest (TypeORM) ----------------------------------
# Dentro de Docker Compose el host DEBE ser "db" (nombre del servicio).
# Si corres Nest en tu PC y solo Postgres en Docker, usa "localhost".
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=multicine
DATABASE_PASSWORD=change_me
DATABASE_NAME=multicine_db

# Opcional: si TypeORM sincroniza el esquema automáticamente (solo desarrollo).
# true | false — si se omite, en development suele quedar activo.
# DATABASE_SYNC=true

# --- HU-006: registro / activación ------------------------------------------
# URL base usada en el enlace del correo de activación (log hasta HU-015).
APP_PUBLIC_URL=http://localhost:3000

# Token CAPTCHA aceptado en desarrollo (sin proveedor externo).
CAPTCHA_DEV_TOKEN=dev-ok
